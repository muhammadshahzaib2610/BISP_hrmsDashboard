@model BISP_hrmsDashboard.Models.DashboardVM
@{
    ViewData["Title"] = "HRMS Dashboard";
}

<style>
    /* Page chrome */
    .container { max-width:100% !important; padding-left:0!important; padding-right:0!important; }
    html,body { margin:0; padding:0; width:100%; overflow-x:hidden; background:#f7f7f9; }

    /* Banner */
    .banner-wrap{ width:100%; }
    .banner-img{ width:100%; height:220px; object-fit:cover; display:block; }

    .page-container{ max-width:1100px; margin:18px auto; padding:0 12px; }

    /* Card */
    .card{
        border:1px solid #e6e7eb; background:#fff; border-radius:14px;
        box-shadow:0 6px 14px rgba(0,0,0,.06); margin-bottom:16px;
    }
    .card-header{
        padding:12px 16px; border-bottom:1px solid #ececef; display:flex; align-items:center; gap:10px;
    }
    .title{
        margin:0; font-weight:800; letter-spacing:.4px; color:#1e1f22; text-transform:uppercase; font-size:.95rem;
        display:flex; align-items:center; gap:8px;
    }
    .icon-bubble{ width:28px; height:28px; border-radius:999px; display:inline-grid; place-items:center;
        background:#f4f5f7; border:1px solid #e1e3e8; }
    .icon{ width:16px; height:16px; stroke:#1f2937; }

    .card-body{ padding:12px 14px 14px 14px; }

    /* Inside layout: KPIs + pie (top), bar full width (bottom) */
    .top-row{
        display:grid; grid-template-columns: 1.2fr .8fr; gap:12px; align-items:stretch;
    }
    @@media (max-width: 768px){ .top-row{ grid-template-columns: 1fr; } }

    .kpi-panel{
        display:grid; grid-template-columns: 1fr; gap:8px;
    }
    .kpi{
        display:flex; justify-content:space-between; align-items:center;
        padding:10px 12px; border-radius:10px; background:#fafbfc; border:1px dashed #e1e3e8;
    }
    .kpi .lbl{ font-weight:600; color:#475569; }
    .kpi .val{ font-weight:900; font-size:1.15rem; color:#111827; }

    .pie-wrap{ height:220px; border:1px solid #eef0f3; border-radius:10px; padding:8px; background:#fff; }
    .bar-wrap{ height:260px; border:1px solid #eef0f3; border-radius:10px; padding:8px; background:#fff; margin-top:10px; }

    /* Tiny footnotes under cards (optional) */
    .meta{ margin-top:6px; font-size:.85rem; color:#6b7280; }
</style>

<!-- Banner -->
<div class="banner-wrap">
    <img src="~/images/banner.jpeg" class="banner-img" alt="HRMS Banner" />
</div>

<div class="page-container">

    <!-- EMPLOYEE CARD -->
    <div class="card" id="employeeCard"
         data-emp-total="@Model.EmpTotal"
         data-emp-active="@Model.EmpActive"
         data-emp-inactive="@Model.EmpInactive">
        <div class="card-header">
            <h5 class="title">
                <span class="icon-bubble" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 20c0-3.314 3.134-6 8-6s8 2.686 8 6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                Employees
            </h5>
        </div>
        <div class="card-body">
            <div class="top-row">
                <!-- KPIs -->
                <div class="kpi-panel">
                    <div class="kpi"><span class="lbl">Total Employees</span><span class="val">@Model.EmpTotal</span></div>
                    <div class="kpi"><span class="lbl">Active Employees</span><span class="val">@Model.EmpActive</span></div>
                    <div class="kpi"><span class="lbl">Inactive Employees</span><span class="val">@Model.EmpInactive</span></div>
                </div>
                <!-- Pie -->
                <div class="pie-wrap">
                    <canvas id="empPie"></canvas>
                </div>
            </div>
            <!-- Histogram -->
            <div class="bar-wrap">
                <canvas id="empBar"></canvas>
            </div>
            @* <div class="meta">Summary shows Active vs Inactive distribution and total headcount.</div> *@
        </div>
    </div>

    <!-- POSITION CARD -->
    <div class="card" id="positionCard"
         data-pos-total="@Model.PosTotal"
         data-pos-filled="@Model.PosFilled"
         data-pos-vacant="@Model.PosVacant">
        <div class="card-header">
            <h5 class="title">
                <span class="icon-bubble" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" fill="none">
                        <path d="M9 7V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <rect x="3" y="7" width="18" height="12" rx="2" stroke-width="1.8"/>
                        <path d="M3 12h18" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M12 12v3" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </span>
                Positions
            </h5>
        </div>
        <div class="card-body">
            <div class="top-row">
                <!-- KPIs -->
                <div class="kpi-panel">
                    <div class="kpi"><span class="lbl">Total Positions</span><span class="val">@Model.PosTotal</span></div>
                    <div class="kpi"><span class="lbl">Filled Posts</span><span class="val">@Model.PosFilled</span></div>
                    <div class="kpi"><span class="lbl">Vacant Posts</span><span class="val">@Model.PosVacant</span></div>
                </div>
                <!-- Pie -->
                <div class="pie-wrap">
                    <canvas id="posPie"></canvas>
                </div>
            </div>
            <!-- Histogram -->
            <div class="bar-wrap">
                <canvas id="posBar"></canvas>
            </div>
            @* <div class="meta">Filled vs Vacant split with overall total for quick staffing view.</div> *@
        </div>
    </div>

    <div class="d-flex gap-2 mt-2">
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">⬅ Back to Home</a>
        <a class="btn btn-outline-dark" asp-controller="Home" asp-action="Dashboard">↻ Refresh</a>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(() => {
  // Palette (consistent & readable on white)
  const palette = {
    empActive:   '#4F46E5', // indigo
    empInactive: '#A3A3A3', // grey
    posFilled:   '#10B981', // emerald
    posVacant:   '#F59E0B', // amber
    border:      'rgba(0,0,0,.08)',
    grid:        'rgba(0,0,0,.06)',
    tooltip:     'rgba(17,24,39,.92)',
    tick:        '#374151'
  };

  /* -------- EMPLOYEE -------- */
  const ec = document.getElementById('employeeCard').dataset;
  const empActive   = Number(ec.empActive   || 0);
  const empInactive = Number(ec.empInactive || 0);
  const empTotal    = Number(ec.empTotal    || (empActive + empInactive));

  // Pie (Employees)
  new Chart(document.getElementById('empPie').getContext('2d'), {
    type: 'pie',
    data: {
      labels: ['Active','Inactive'],
      datasets: [{
        data: [empActive, empInactive],
        backgroundColor: [palette.empActive, palette.empInactive],
        borderColor: '#fff', borderWidth: 2
      }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ position:'bottom', labels:{ boxWidth:14, color:'#1f2937' } },
                tooltip:{ backgroundColor: palette.tooltip } }
    }
  });

  // Bar (Employees)
  new Chart(document.getElementById('empBar').getContext('2d'), {
    type: 'bar',
    data: {
      labels: ['Total','Active','Inactive'],
      datasets: [{
        label: 'Employees',
        data: [empTotal, empActive, empInactive],
        backgroundColor: ['#111827', palette.empActive, palette.empInactive],
        borderColor: palette.border, borderWidth: 1.2, borderRadius: 6, maxBarThickness: 56
      }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      scales:{
        x:{ grid:{ display:false }, ticks:{ color:palette.tick, font:{ weight:'600' } } },
        y:{ beginAtZero:true, grid:{ color:palette.grid }, ticks:{ color:palette.tick } }
      },
      plugins:{ legend:{ display:false }, tooltip:{ backgroundColor: palette.tooltip } }
    }
  });

  /* -------- POSITION -------- */
  const pc = document.getElementById('positionCard').dataset;
  const posFilled = Number(pc.posFilled || 0);
  const posVacant = Number(pc.posVacant || 0);
  const posTotal  = Number(pc.posTotal  || (posFilled + posVacant));

  // Pie (Positions)
  new Chart(document.getElementById('posPie').getContext('2d'), {
    type: 'pie',
    data: {
      labels: ['Filled','Vacant'],
      datasets: [{
        data: [posFilled, posVacant],
        backgroundColor: [palette.posFilled, palette.posVacant],
        borderColor: '#fff', borderWidth: 2
      }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ position:'bottom', labels:{ boxWidth:14, color:'#1f2937' } },
                tooltip:{ backgroundColor: palette.tooltip } }
    }
  });

  // Bar (Positions)
  new Chart(document.getElementById('posBar').getContext('2d'), {
    type: 'bar',
    data: {
      labels: ['Total','Filled','Vacant'],
      datasets: [{
        label: 'Positions',
        data: [posTotal, posFilled, posVacant],
        backgroundColor: ['#111827', palette.posFilled, palette.posVacant],
        borderColor: palette.border, borderWidth: 1.2, borderRadius: 6, maxBarThickness: 56
      }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      scales:{
        x:{ grid:{ display:false }, ticks:{ color:palette.tick, font:{ weight:'600' } } },
        y:{ beginAtZero:true, grid:{ color:palette.grid }, ticks:{ color:palette.tick } }
      },
      plugins:{ legend:{ display:false }, tooltip:{ backgroundColor: palette.tooltip } }
    }
  });

})();
</script>