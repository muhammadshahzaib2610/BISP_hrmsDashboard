@{
    ViewData["Title"] = "Home";
    ViewBag.HideNav = true;
}

<style>
    .container {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        overflow-x: hidden
    }

    .banner-wrap {
        width: 100%
    }

        .banner-wrap img.banner-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block
        }

    .sticky-navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
        background: #f8f9fa;
        border-bottom: 1px solid #c5c8cb;
        box-shadow: 0 2px 8px rgba(0,0,0,.2);
        margin: 0;
        padding: 0
    }

        .sticky-navbar .navbar-nav {
            margin: 0 auto;
            gap: 12px
        }

        .sticky-navbar .nav-link {
            text-transform: uppercase;
            font-weight: 600;
            padding: .75rem 1rem
        }

            .sticky-navbar .nav-link.active, .sticky-navbar .nav-link:hover {
                border-bottom: 2px solid #0d6efd;
            }

    .page-container {
        max-width: 1100px;
        margin: 1.25rem auto;
        padding: 0 12px
    }

    .form-hint {
        font-size: .85rem;
        color: #6c757d
    }
</style>


<!-- Banner -->
<div class="banner-wrap">
    <img src="~/images/banner.jpeg" alt="HRMS Banner" class="banner-img" />
</div>



<nav class="navbar sticky-navbar justify-content-center">
    <ul class="navbar-nav flex-row">
        <li><a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a></li>
        <li><a class="nav-link" asp-controller="Employee_dataEntryForm" asp-action="Employee_DEF">Employee Data Form</a></li>
        <li><a class="nav-link" asp-controller="Employee" asp-action="Search">Employee Search</a></li>
        <li><a class="nav-link" asp-controller="Position" asp-action="Create">Position</a></li>
        <li><a class="nav-link" asp-controller="Position" asp-action="Search">Position Search</a></li>
        <li><a class="nav-link" asp-controller="Position" asp-action="Unassign">Position Unassign</a></li>
        <li><a class="nav-link" asp-controller="Dashboard" asp-action="Index">HRMS Dashboard</a></li>
    </ul>
</nav>
